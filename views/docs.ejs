<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - LoL Human REST API</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-main: #191c20;
            --bg-card: #1d2025;
            --bg-code: #14171a;
            --bg-hover: #252930;
            --border-color: #2b3038;
            --text-primary: #f1f5f9;
            --text-secondary: #cbd5e1;
            --text-muted: #94a3b8;
            --accent: #f06a6a;
        }

        /* Variabel CSS untuk Mode Terang (Light Mode) */
        body.light-mode {
            --bg-main: #f1f5f9;
            --bg-card: #ffffff;
            --bg-code: #f8fafc;
            --bg-hover: #f1f5f9;
            --border-color: #e2e8f0;
            --text-primary: #0f172a;
            --text-secondary: #334155;
            --text-muted: #64748b;
            --accent: #f06a6a;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Poppins', sans-serif; }
        body { background-color: var(--bg-main); color: var(--text-primary); display: flex; min-height: 100vh; transition: background-color 0.2s, color 0.2s; }
        
        /* Sidebar */
        .sidebar { width: 235px; background-color: var(--bg-card); border-right: 1px solid var(--border-color); padding: 20px 14px; display: flex; flex-direction: column; position: fixed; height: 100vh; overflow-y: auto; transition: background-color 0.2s, border-color 0.2s; }
        .brand { font-size: 21px; font-weight: 700; text-align: center; margin-bottom: 24px; color: var(--text-primary); text-decoration: none; }
        .brand span { color: var(--accent); }
        .nav-item { display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-radius: 8px; color: var(--text-secondary); text-decoration: none; font-size: 13px; margin-bottom: 4px; transition: 0.15s; }
        .nav-item:hover { background-color: var(--bg-hover); color: var(--text-primary); }
        .nav-item.active { background-color: var(--accent); color: #fff; font-weight: 500; }
        .nav-divider { border-top: 1px solid var(--border-color); margin: 12px 0; }

        /* Main Content */
        .main { margin-left: 235px; flex: 1; padding: 24px 32px; }
        .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 26px; }
        .topbar h1 { font-size: 24px; font-weight: 600; color: var(--text-primary); }
        .topbar-right { display: flex; align-items: center; gap: 14px; }
        .search-box { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 7px 14px; display: flex; align-items: center; gap: 8px; width: 240px; }
        .search-box input { background: transparent; border: none; color: var(--text-primary); font-size: 13px; outline: none; width: 100%; }
        .theme-btn { background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-secondary); width: 34px; height: 34px; border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.2s; }
        .theme-btn:hover { border-color: var(--accent); color: var(--accent); }
        .avatar { width: 32px; height: 32px; border-radius: 50%; background-color: var(--accent); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 13px; text-decoration: none; }

        /* 4 Stat Cards */
        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-bottom: 20px; }
        .card { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 10px; padding: 20px 22px; transition: background-color 0.2s, border-color 0.2s; }
        .stat-card { display: flex; align-items: center; gap: 16px; }
        .stat-icon { color: var(--accent); font-size: 18px; width: 28px; text-align: center; }
        .stat-label { font-size: 12px; color: var(--text-muted); margin-bottom: 2px; }
        .stat-value { font-size: 19px; font-weight: 600; color: var(--text-primary); }

        /* API Key Quick Banner */
        .apikey-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 10px; padding: 14px 22px; font-size: 13px; }
        .apikey-code { background: var(--bg-code); border: 1px solid var(--border-color); padding: 4px 10px; border-radius: 6px; color: var(--accent); font-family: monospace; }

        /* Content Sections */
        .section-title { font-size: 18px; font-weight: 600; margin-bottom: 12px; color: var(--text-primary); }
        .sk-list { list-style: decimal; padding-left: 20px; font-size: 13px; color: var(--text-secondary); line-height: 1.8; }
        .bottom-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 20px; margin-top: 20px; }
        .thanks-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 13px; color: var(--text-secondary); }
        .thanks-grid ul { list-style: disc; padding-left: 18px; line-height: 1.85; }
        .contact-links a { display: flex; align-items: center; gap: 10px; color: var(--text-secondary); text-decoration: none; font-size: 13px; margin-top: 10px; }
        .contact-links a:hover { color: var(--accent); }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar">
        <a href="/docs" class="brand">lolhuman<span>api.</span></a>
        <a href="/docs" class="nav-item active"><i class="fa-solid fa-house"></i> Dashboard</a>
        <a href="/pricing" class="nav-item"><i class="fa-regular fa-credit-card"></i> Pricing</a>
        <a href="/profile" class="nav-item"><i class="fa-regular fa-user"></i> My Profile & Key</a>
        <div class="nav-divider"></div>
        <a href="/socialmedia" class="nav-item"><i class="fa-solid fa-download"></i> Downloader</a>
        <a href="/berita" class="nav-item"><i class="fa-solid fa-circle-info"></i> Information</a>
        <a href="/animanga" class="nav-item"><i class="fa-solid fa-book-open"></i> Anime Manga</a>
        <a href="/searching" class="nav-item"><i class="fa-solid fa-magnifying-glass"></i> Searcher</a>
        <a href="/textpro" class="nav-item"><i class="fa-solid fa-font"></i> TextPro.me</a>
        <a href="/photofunia" class="nav-item"><i class="fa-regular fa-image"></i> Photofunia</a>
        <a href="/creator" class="nav-item"><i class="fa-solid fa-wand-magic-sparkles"></i> Creator</a>
        <a href="/primbon" class="nav-item"><i class="fa-regular fa-star"></i> Primbon</a>
        <a href="/asupan" class="nav-item"><i class="fa-solid fa-video"></i> Asupan</a>
        <a href="/nsfwsfw" class="nav-item"><i class="fa-solid fa-masks-theater"></i> Random Image</a>
        <div class="nav-divider"></div>
        <a href="/users/logout" class="nav-item" style="color: #f06a6a;"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
    </aside>

    <!-- Main Content -->
    <main class="main">
        <div class="topbar">
            <h1>Dashboard</h1>
            <div class="topbar-right">
                <div class="search-box">
                    <i class="fa-solid fa-magnifying-glass" style="color: var(--text-muted); font-size: 12px;"></i>
                    <input type="text" placeholder="Search...">
                </div>
                <!-- Tombol Toggle Mode Terang / Gelap -->
                <button id="themeToggle" class="theme-btn" title="Ganti Mode Terang / Gelap">
                    <i id="themeIcon" class="fa-regular fa-moon"></i>
                </button>
                <a href="/profile" class="avatar" title="<%= username %>"><%= username.charAt(0).toUpperCase() %></a>
            </div>
        </div>

        <!-- 4 Kartu Statistik Dinamis -->
        <div class="stats-grid">
            <div class="card stat-card">
                <div class="stat-icon"><i class="fa-regular fa-eye"></i></div>
                <div>
                    <div class="stat-label">Visitor</div>
                    <div class="stat-value" id="statVisitor"><%= visitor %></div>
                </div>
            </div>
            <div class="card stat-card">
                <div class="stat-icon"><i class="fa-regular fa-user"></i></div>
                <div>
                    <div class="stat-label">Users</div>
                    <div class="stat-value" id="statUsers"><%= totalUsers %></div>
                </div>
            </div>
            <div class="card stat-card">
                <div class="stat-icon"><i class="fa-solid fa-arrows-rotate"></i></div>
                <div>
                    <div class="stat-label">Total Requests</div>
                    <div class="stat-value" id="statTotalReq"><%= totalRequests %></div>
                </div>
            </div>
            <div class="card stat-card">
                <div class="stat-icon"><i class="fa-regular fa-clock"></i></div>
                <div>
                    <div class="stat-label">Requests Today</div>
                    <div class="stat-value" id="statReqToday"><%= requestsToday %></div>
                </div>
            </div>
        </div>

        <!-- Info Akun & API Key Aktif -->
        <div class="apikey-bar">
            <div>
                Halo, <strong><%= username %></strong> (<%= premium ? 'VIP / Premium' : 'Free Plan' %>) — Sisa Limit Harian: <strong id="userLimit" style="color: var(--accent);"><%= limit %></strong>
            </div>
            <div>
                API Key: <span class="apikey-code" id="userApikey"><%= apikey %></span>
            </div>
        </div>

        <!-- S&K Card -->
        <div class="card">
            <div class="section-title">S&K</div>
            <ol class="sk-list">
                <li>Jangan flooding requests.</li>
                <li>Membuat banyak akun pada IP yang sama maka IP otomatis akan di block.</li>
                <li>Owner dapat sewaktu waktu mengubah ketentuan di website ini, demi menjaga kualitas website.</li>
                <li>Dilarang keras untuk menyebarkan apikey Anda, jika ketahuan. InsyaAllah akan di block :)</li>
                <li>Jangan ditembak atuh, sakit.</li>
                <li>Owner tidak bertanggung jawab atas apa yang Anda lakukan dalam penggunaan website ini.</li>
            </ol>
        </div>

        <!-- Thanks To & Contact Me -->
        <div class="bottom-grid">
            <div class="card">
                <div class="section-title">Thanks To</div>
                <div class="thanks-grid">
                    <ul>
                        <li>Allah SWT</li>
                        <li>My Friends</li>
                        <li>Mat</li>
                        <li>Ben</li>
                        <li>Kee</li>
                        <li>Krypton Byte</li>
                        <li>ArugaZ</li>
                        <li>And all of you who have used the web wisely and always supported me.</li>
                    </ul>
                    <ul>
                        <li>My Parents</li>
                        <li>Aziz</li>
                        <li>Pais</li>
                        <li>Faiz</li>
                        <li>Riz</li>
                        <li>Chipa</li>
                        <li>Bang Hasan</li>
                    </ul>
                </div>
            </div>
            <div class="card">
                <div class="section-title">Contact Me</div>
                <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 12px;">
                    Interesting in buying Premium Plan or VIP Plan? Found bugs? Requests features? You can contact me via bellow
                </p>
                <div class="contact-links">
                    <a href="https://wa.me/6281234567890" target="_blank"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>
                    <a href="https://t.me/username" target="_blank"><i class="fa-brands fa-telegram"></i> Telegram</a>
                    <a href="https://instagram.com/username" target="_blank"><i class="fa-brands fa-instagram"></i> Instagram</a>
                </div>
            </div>
        </div>
    </main>

    <script>
        // 1. FITUR MODE TERANG / GELAP (LIGHT & DARK MODE)
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');

        function applyTheme(theme) {
            if (theme === 'light') {
                document.body.classList.add('light-mode');
                themeIcon.className = 'fa-regular fa-sun';
            } else {
                document.body.classList.remove('light-mode');
                themeIcon.className = 'fa-regular fa-moon';
            }
        }

        // Muat tema yang tersimpan di browser
        const savedTheme = localStorage.getItem('lolhuman_theme') || 'dark';
        applyTheme(savedTheme);

        themeToggle.addEventListener('click', () => {
            const isLight = document.body.classList.contains('light-mode');
            const nextTheme = isLight ? 'dark' : 'light';
            localStorage.setItem('lolhuman_theme', nextTheme);
            applyTheme(nextTheme);
        });

        // 2. AUTO-SYNC LIMIT & STATISTIK SAAT USER KEMBALI KE TAB DASHBOARD
        const currentApikey = '<%= apikey %>';
        async function syncLimitAndStats() {
            try {
                const res = await fetch('/api/cekey?apikey=' + encodeURIComponent(currentApikey));
                const data = await res.json();
                if (data && data.status === 200 && data.result) {
                    document.getElementById('userLimit').textContent = data.result.limit;
                    if (data.result.stats) {
                        document.getElementById('statVisitor').textContent = data.result.stats.visitor;
                        document.getElementById('statUsers').textContent = data.result.stats.totalUsers;
                        document.getElementById('statTotalReq').textContent = data.result.stats.totalRequests;
                        document.getElementById('statReqToday').textContent = data.result.stats.requestsToday;
                    }
                }
            } catch (err) {
                console.error('Gagal sinkronisasi limit:', err);
            }
        }

        // Update otomatis setiap kali user kembali ke tab ini atau setiap 5 detik
        window.addEventListener('focus', syncLimitAndStats);
        setInterval(syncLimitAndStats, 5000);
    </script>
</body>
</html>
