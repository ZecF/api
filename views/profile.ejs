<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile - LoL Human REST API</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Poppins', sans-serif; }
        body { background-color: #191c20; color: #f1f5f9; display: flex; min-height: 100vh; }
        .sidebar { width: 235px; background-color: #1d2025; border-right: 1px solid #2b3038; padding: 20px 14px; position: fixed; height: 100vh; }
        .brand { font-size: 21px; font-weight: 700; text-align: center; margin-bottom: 24px; color: #fff; display: block; text-decoration: none; }
        .brand span { color: #f06a6a; }
        .nav-item { display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-radius: 8px; color: #cbd5e1; text-decoration: none; font-size: 13px; margin-bottom: 4px; }
        .nav-item.active, .nav-item:hover { background-color: #f06a6a; color: #fff; }
        .main { margin-left: 235px; flex: 1; padding: 28px 36px; max-width: 960px; }
        .card { background-color: #1d2025; border: 1px solid #2b3038; border-radius: 10px; padding: 24px; margin-bottom: 20px; }
        .info-row { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #2b3038; font-size: 13.5px; }
        .form-control { width: 100%; background: #14171a; border: 1px solid #2b3038; border-radius: 8px; padding: 10px 14px; color: #fff; font-size: 13px; margin: 10px 0 14px; outline: none; }
        .btn { background: #f06a6a; color: #fff; border: none; padding: 10px 20px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; }
    </style>
</head>
<body>
    <aside class="sidebar">
        <a href="/docs" class="brand">lolhuman<span>api.</span></a>
        <a href="/docs" class="nav-item"><i class="fa-solid fa-house"></i> Dashboard</a>
        <a href="/pricing" class="nav-item"><i class="fa-regular fa-credit-card"></i> Pricing</a>
        <a href="/profile" class="nav-item active"><i class="fa-regular fa-user"></i> Profile</a>
        <a href="/users/logout" class="nav-item" style="margin-top: 20px;"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
    </aside>

    <main class="main">
        <h2 style="margin-bottom: 20px;">My Profile & API Key</h2>
        <%- include('./layouts/msg') %>

        <div class="card">
            <div class="info-row"><span>Username</span><strong><%= user.username %></strong></div>
            <div class="info-row"><span>Email</span><strong><%= user.email %></strong></div>
            <div class="info-row"><span>Status Plan</span><strong style="color: #f06a6a;"><%= user.premium ? 'VIP / Premium' : 'Free User' %></strong></div>
            <div class="info-row"><span>API Key</span><code style="color: #f06a6a;"><%= user.apikey %></code></div>
            <div class="info-row" style="border:none;"><span>Sisa Limit Harian</span><strong><%= user.limit %></strong></div>
        </div>

        <div class="card">
            <h3 style="font-size: 16px; margin-bottom: 6px;">Custom API Key</h3>
            <p style="font-size: 12.5px; color: #94a3b8;">Ubah kode API Key sesuai keinginanmu.</p>
            <form action="/users/customapikey" method="POST">
                <input type="text" name="customkey" class="form-control" placeholder="Masukkan API Key baru..." required>
                <button type="submit" class="btn">Simpan API Key</button>
            </form>
        </div>
    </main>
</body>
</html>
