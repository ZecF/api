<% if (success_msg && success_msg.length > 0) { %>
    <div style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.35); color: #34d399; padding: 12px 16px; border-radius: 10px; font-size: 13px; margin-bottom: 16px;">
        <%= success_msg %>
    </div>
<% } %>

<% if (error_msg && error_msg.length > 0) { %>
    <div style="background: rgba(240, 106, 106, 0.12); border: 1px solid rgba(240, 106, 106, 0.35); color: #f06a6a; padding: 12px 16px; border-radius: 10px; font-size: 13px; margin-bottom: 16px;">
        <%= error_msg %>
    </div>
<% } %>

<% if (error && error.length > 0) { %>
    <div style="background: rgba(240, 106, 106, 0.12); border: 1px solid rgba(240, 106, 106, 0.35); color: #f06a6a; padding: 12px 16px; border-radius: 10px; font-size: 13px; margin-bottom: 16px;">
        <%= error %>
    </div>
<% } %>
